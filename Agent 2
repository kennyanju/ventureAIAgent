def build_financial_model(filepath: Path):
    """Build a functional 5-Year Financial Model with live Excel formulas."""
    wb = Workbook()
    
    # Styling Tokens
    font_header = Font(name="Calibri", size=11, bold=True, color="FFFFFF")
    font_bold = Font(name="Calibri", size=11, bold=True)
    fill_navy = PatternFill(start_color=NAVY, end_color=NAVY, fill_type="solid")
    fill_accent = PatternFill(start_color="FFF2CC", end_color="FFF2CC", fill_type="solid") # Input cells
    align_right = Alignment(horizontal="right")
    align_center = Alignment(horizontal="center")
    border_thin = Border(bottom=Side(style='thin', color='DDDDDD'))
    border_double = Border(bottom=Side(style='double', color='000000'), top=Side(style='thin', color='000000'))

    # Tab 1: Cover
    ws_cover = wb.active
    ws_cover.title = "Summary"
    ws_cover["A1"] = f"{VENTURE_NAME} — Financial Architecture"
    ws_cover["A1"].font = Font(size=16, bold=True, color=NAVY)
    ws_cover["A2"] = f"Generated: {date.today()} | Currency: GBP (£)"
    
    # Tab 2: 5-Year Statement
    ws_pnl = wb.create_sheet(title="5-Year P&L")
    headers = ["Financial Line Item (£)", "Year 1", "Year 2", "Year 3", "Year 4", "Year 5"]
    ws_pnl.append(headers)

    for col in range(1, 7):
        cell = ws_pnl.cell(row=1, column=col)
        cell.font = font_header
        cell.fill = fill_navy
        cell.alignment = align_center if col > 1 else Alignment(horizontal="left")

    rows_data = [
        ("Target Active Customers", 120, 450, 1500, 4000, 8500),
        ("Average Revenue Per User (ARPU)", 2400, 2500, 2600, 2700, 2800),
        ("Gross Revenue", "=B2*B3", "=C2*C3", "=D2*D3", "=E2*E3", "=F2*F3"),
        ("Cost of Goods Sold (COGS)", "=B4*0.15", "=C4*0.14", "=D4*0.12", "=E4*0.10", "=F4*0.10"),
        ("Gross Profit", "=B4-B5", "=C4-C5", "=D4-D5", "=E4-E5", "=F4-F5"),
        ("Sales & Marketing (S&M)", 80000, 180000, 450000, 1100000, 2000000),
        ("Research & Development (R&D)", 120000, 220000, 500000, 1000000, 1800000),
        ("General & Administrative (G&A)", 50000, 90000, 200000, 450000, 800000),
        ("Total Operating Expenses (OpEx)", "=SUM(B7:B9)", "=SUM(C7:C9)", "=SUM(D7:D9)", "=SUM(E7:E9)", "=SUM(F7:F9)"),
        ("EBITDA", "=B6-B10", "=C6-C10", "=D6-D10", "=E6-E10", "=F6-F10")
    ]

    for r_idx, row_vals in enumerate(rows_data, start=2):
        for c_idx, val in enumerate(row_vals, start=1):
            cell = ws_pnl.cell(row=r_idx, column=c_idx, value=val)
            if c_idx > 1 and isinstance(val, (int, float)):
                cell.number_format = '#,##0' if r_idx == 2 else '£#,##0'
            elif c_idx > 1 and str(val).startswith('='):
                cell.number_format = '£#,##0'
            
            # Format Key Summary Rows
            if r_idx in [4, 6, 10, 11]:
                cell.font = font_bold
            if r_idx == 11: # EBITDA Row
                cell.border = border_double

    # Auto-fit columns
    for col in ws_pnl.columns:
        max_len = max(len(str(cell.value or '')) for cell in col)
        col_letter = get_column_letter(col[0].column)
        ws_pnl.column_dimensions[col_letter].width = max(max_len + 3, 14)

    wb.save(filepath)
    print(f"  📊 Financial Model Generated with Active Formulas: {filepath.name}")

