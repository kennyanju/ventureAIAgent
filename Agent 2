def build_investor_deck(filepath: Path, slides_data: list):
    """Build a styled widescreen PowerPoint presentation."""
    prs = Presentation()
    prs.slide_width = PPTInches(13.33)
    prs.slide_height = PPTInches(7.5)

    # Slide 1: Cover
    blank_layout = prs.slide_layouts[6]
    slide_cover = prs.slides.add_slide(blank_layout)

    tb = slide_cover.shapes.add_textbox(PPTInches(1.5), PPTInches(2.5), PPTInches(10.33), PPTInches(2.5))
    tf = tb.text_frame
    tf.word_wrap = True
    
    p = tf.paragraphs[0]
    p.text = VENTURE_NAME
    p.font.size = PPTPt(44)
    p.font.bold = True
    p.font.color.rgb = PPTRGBColor.from_string(NAVY)

    p2 = tf.add_paragraph()
    p2.text = "Investor Pitch Deck — Executive Overview"
    p2.font.size = PPTPt(22)
    p2.font.color.rgb = PPTRGBColor.from_string(BLUE)

    # Content Slides
    for slide_info in slides_data:
        slide = prs.slides.add_slide(blank_layout)
        
        # Header
        header_box = slide.shapes.add_textbox(PPTInches(0.8), PPTInches(0.6), PPTInches(11.7), PPTInches(1.0))
        htf = header_box.text_frame
        hp = htf.paragraphs[0]
        hp.text = slide_info["title"]
        hp.font.size = PPTPt(28)
        hp.font.bold = True
        hp.font.color.rgb = PPTRGBColor.from_string(NAVY)

        # Bullets / Content
        body_box = slide.shapes.add_textbox(PPTInches(0.8), PPTInches(1.8), PPTInches(11.7), PPTInches(5.0))
        btf = body_box.text_frame
        btf.word_wrap = True

        for idx, bullet in enumerate(slide_info["bullets"]):
            bp = btf.paragraphs[0] if idx == 0 else btf.add_paragraph()
            bp.text = f"• {bullet}"
            bp.font.size = PPTPt(18)
            bp.font.color.rgb = PPTRGBColor.from_string(DARK_TEXT)
            bp.space_after = PPTPt(12)

    prs.save(filepath)
    print(f"  📊 Presentation Deck Written: {filepath.name}")

