def create_spreadsheet(filepath: Path, title: str,
                        tabs: list):
    """Create a structured Excel workbook."""
    wb = Workbook()
    
    # Cover tab
    ws_cover = wb.active
    ws_cover.title = "README"
    ws_cover["A1"] = VENTURE_NAME
    ws_cover["A2"] = title
    ws_cover["A3"] = "Version: 1.0"
    ws_cover["A4"] = "Instructions: [Add instructions here]"
    
    # Create tabs
    for tab in tabs:
        ws = wb.create_sheet(title=tab["name"])
        if "headers" in tab:
            for col, header in enumerate(
                tab["headers"], 1
            ):
                cell = ws.cell(row=1, column=col, 
                               value=header)
                cell.font = __import__(
                    'openpyxl.styles', 
                    fromlist=['Font']
                ).Font(bold=True)
    
    wb.save(filepath)
    print(f"  📊 Created: {filepath.name}")

