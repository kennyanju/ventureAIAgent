def build_docx_document(filepath: Path, title: str, subtitle: str, content_blocks: list):
    """Build a fully styled Word document with tables, headings, and headers."""
    doc = Document()
    
    # Page Setup
    for section in doc.sections:
        section.top_margin = Inches(1)
        section.bottom_margin = Inches(1)
        section.left_margin = Inches(1)
        section.right_margin = Inches(1)

    # Title / Header Block
    p_title = doc.add_paragraph()
    p_title.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run_title = p_title.add_run(f"{VENTURE_NAME.upper()}\n{title.upper()}")
    run_title.font.size = Pt(24)
    run_title.font.bold = True
    run_title.font.color.rgb = RGBColor.from_string(NAVY)

    p_sub = doc.add_paragraph()
    p_sub.alignment = WD_ALIGN_PARAGRAPH.CENTER
    run_sub = p_sub.add_run(subtitle)
    run_sub.font.size = Pt(14)
    run_sub.font.italic = True
    run_sub.font.color.rgb = RGBColor.from_string("555555")

    doc.add_paragraph().paragraph_format.space_after = Pt(20)

    # Content Injection
    for block in content_blocks:
        b_type = block.get("type", "paragraph")
        
        if b_type == "h1":
            h = doc.add_heading(block["text"], level=1)
            h.runs[0].font.color.rgb = RGBColor.from_string(NAVY)
            h.paragraph_format.space_before = Pt(14)
            h.paragraph_format.space_after = Pt(6)

        elif b_type == "h2":
            h = doc.add_heading(block["text"], level=2)
            h.runs[0].font.color.rgb = RGBColor.from_string(BLUE)
            h.paragraph_format.space_before = Pt(10)
            h.paragraph_format.space_after = Pt(4)

        elif b_type == "paragraph":
            p = doc.add_paragraph(block["text"])
            p.paragraph_format.line_spacing = 1.15
            p.paragraph_format.space_after = Pt(6)

        elif b_type == "callout":
            table = doc.add_table(rows=1, cols=1)
            table.autofit = False
            cell = table.cell(0, 0)
            cell.text = block["text"]
            # Light background shading
            shading = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{LIGHT_GRAY}"/>')
            cell._tc.get_or_add_tcPr().append(shading)
            doc.add_paragraph().paragraph_format.space_after = Pt(6)

        elif b_type == "table":
            headers = block["headers"]
            data = block["data"]
            tbl = doc.add_table(rows=len(data) + 1, cols=len(headers))
            tbl.style = 'Table Grid'
            
            # Format Headers
            hdr_cells = tbl.rows[0].cells
            for i, title in enumerate(headers):
                hdr_cells[i].text = title
                shd = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{NAVY}"/>')
                hdr_cells[i]._tc.get_or_add_tcPr().append(shd)
                for p in hdr_cells[i].paragraphs:
                    for r in p.runs:
                        r.font.bold = True
                        r.font.color.rgb = RGBColor(255, 255, 255)

            # Populate Rows
            for r_idx, row_data in enumerate(data):
                row_cells = tbl.rows[r_idx + 1].cells
                for c_idx, val in enumerate(row_data):
                    row_cells[c_idx].text = str(val)

            doc.add_paragraph().paragraph_format.space_after = Pt(10)

    doc.save(filepath)
    print(f"  📄 Document Written: {filepath.name}")

