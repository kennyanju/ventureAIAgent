### 5.2 Reference scaffold (fallback only — adapt values from `venture_data`, do not hardcode)

```python
#!/usr/bin/env python3
"""
Venture Studio AI — Deliverables Factory
Master File Creation & Content Injector
NOTE: This scaffold is executed directly by the agent, not shown to the user.
All *_data values below must be pulled from venture_data, not hardcoded.
"""

import os, json
from pathlib import Path
from datetime import date

from docx import Document
from docx.shared import Inches, Pt, RGBColor
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml import parse_xml
from docx.oxml.ns import nsdecls

from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

from pptx import Presentation
from pptx.util import Inches as PPTInches, Pt as PPTPt
from pptx.dml.color import RGBColor as PPTRGBColor

VENTURE_NAME = venture_data["venture_name"]          # from Stage 1/2 output, not hardcoded
BASE_DIR = Path(f"./{VENTURE_NAME.replace(' ', '_')}_Studio_Pack")

NAVY, BLUE, LIGHT_GRAY, DARK_TEXT = "1F3864", "2D5BE3", "F2F2F2", "1A1A2E"

FOLDER_STRUCTURE = {
    "00_Executive_Summary": [], "01_Idea_Validation": [], "02_Strategy": [],
    "03_Business_Case": [], "04_Operating_Model": [], "05_Product": [],
    "06_Architecture": ["Architecture_Diagrams"], "07_Security_Risk_Compliance": [],
    "08_Financial_Model": [], "09_Program_Management": [],
    "10_Document_Library": ["Executive", "Product", "Operations", "Sales", "Marketing"],
    "11_GTM_Strategy": [], "12_Brand_Website": ["Website/css", "Website/js", "Website/blog"],
    "13_Technical_Specification": ["Database", "API"], "14_Deliverables_Index": [],
    "15_Final_Pack": [],
}

def init_workspace():
    BASE_DIR.mkdir(exist_ok=True)
    for folder, subs in FOLDER_STRUCTURE.items():
        (BASE_DIR / folder).mkdir(exist_ok=True)
        for sub in subs:
            (BASE_DIR / folder / sub).mkdir(parents=True, exist_ok=True)

def build_docx_document(filepath, title, subtitle, content_blocks):
    doc = Document()
    for section in doc.sections:
        section.top_margin = section.bottom_margin = Inches(1)
        section.left_margin = section.right_margin = Inches(1)

    p = doc.add_paragraph(); p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    r = p.add_run(f"{VENTURE_NAME.upper()}\n{title.upper()}")
    r.font.size, r.font.bold, r.font.color.rgb = Pt(24), True, RGBColor.from_string(NAVY)

    p2 = doc.add_paragraph(); p2.alignment = WD_ALIGN_PARAGRAPH.CENTER
    r2 = p2.add_run(subtitle)
    r2.font.size, r2.font.italic, r2.font.color.rgb = Pt(14), True, RGBColor.from_string("555555")

    for block in content_blocks:
        t = block.get("type", "paragraph")
        if t == "h1":
            h = doc.add_heading(block["text"], level=1)
            h.runs[0].font.color.rgb = RGBColor.from_string(NAVY)
        elif t == "h2":
            h = doc.add_heading(block["text"], level=2)
            h.runs[0].font.color.rgb = RGBColor.from_string(BLUE)
        elif t == "paragraph":
            doc.add_paragraph(block["text"]).paragraph_format.line_spacing = 1.15
        elif t == "callout":
            tbl = doc.add_table(rows=1, cols=1)
            tbl.cell(0, 0).text = block["text"]
            shd = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{LIGHT_GRAY}"/>')
            tbl.cell(0, 0)._tc.get_or_add_tcPr().append(shd)
        elif t == "table":
            headers, data = block["headers"], block["data"]
            tbl = doc.add_table(rows=len(data) + 1, cols=len(headers)); tbl.style = "Table Grid"
            for i, h in enumerate(headers):
                cell = tbl.rows[0].cells[i]; cell.text = h
                shd = parse_xml(f'<w:shd {nsdecls("w")} w:fill="{NAVY}"/>')
                cell._tc.get_or_add_tcPr().append(shd)
                for pp in cell.paragraphs:
                    for rr in pp.runs:
                        rr.font.bold, rr.font.color.rgb = True, RGBColor(255, 255, 255)
            for ridx, row in enumerate(data):
                for cidx, val in enumerate(row):
                    tbl.rows[ridx + 1].cells[cidx].text = str(val)
    doc.save(filepath)

def build_financial_model(filepath, fin):
    """fin = venture_data['stage8_financials'] — real assumptions & 5yr figures, not samples."""
    wb = Workbook()
    ws_cover = wb.active; ws_cover.title = "Summary"
    ws_cover["A1"] = f"{VENTURE_NAME} — Financial Architecture"
    ws_cover["A1"].font = Font(size=16, bold=True, color=NAVY)
    ws_cover["A2"] = f"Generated: {date.today()} | Currency: {fin.get('currency', 'GBP (£)')}"

    ws = wb.create_sheet("5-Year P&L")
    headers = ["Financial Line Item", "Year 1", "Year 2", "Year 3", "Year 4", "Year 5"]
    ws.append(headers)
    for col in range(1, 7):
        c = ws.cell(row=1, column=col)
        c.font = Font(bold=True, color="FFFFFF")
        c.fill = PatternFill(start_color=NAVY, end_color=NAVY, fill_type="solid")

    # rows populated from fin["pnl_5yr"] — the real, stage-8-derived rows, not sample data
    for r_idx, row in enumerate(fin["pnl_5yr"], start=2):
        for c_idx, val in enumerate(row, start=1):
            ws.cell(row=r_idx, column=c_idx, value=val)

    for col in ws.columns:
        width = max(len(str(c.value or "")) for c in col) + 3
        ws.column_dimensions[get_column_letter(col[0].column)].width = max(width, 14)
    wb.save(filepath)

def build_investor_deck(filepath, slides_data):
    prs = Presentation()
    prs.slide_width, prs.slide_height = PPTInches(13.33), PPTInches(7.5)
    layout = prs.slide_layouts[6]

    cover = prs.slides.add_slide(layout)
    tb = cover.shapes.add_textbox(PPTInches(1.5), PPTInches(2.5), PPTInches(10.33), PPTInches(2.5))
    tf = tb.text_frame; tf.word_wrap = True
    p = tf.paragraphs[0]; p.text = VENTURE_NAME
    p.font.size, p.font.bold, p.font.color.rgb = PPTPt(44), True, PPTRGBColor.from_string(NAVY)
    p2 = tf.add_paragraph(); p2.text = "Investor Pitch Deck — Executive Overview"
    p2.font.size, p2.font.color.rgb = PPTPt(22), PPTRGBColor.from_string(BLUE)

    for s in slides_data:
        slide = prs.slides.add_slide(layout)
        hb = slide.shapes.add_textbox(PPTInches(0.8), PPTInches(0.6), PPTInches(11.7), PPTInches(1.0))
        hp = hb.text_frame.paragraphs[0]; hp.text = s["title"]
        hp.font.size, hp.font.bold, hp.font.color.rgb = PPTPt(28), True, PPTRGBColor.from_string(NAVY)

        bb = slide.shapes.add_textbox(PPTInches(0.8), PPTInches(1.8), PPTInches(11.7), PPTInches(5.0))
        btf = bb.text_frame; btf.word_wrap = True
        for i, bullet in enumerate(s["bullets"]):
            bp = btf.paragraphs[0] if i == 0 else btf.add_paragraph()
            bp.text = f"• {bullet}"
            bp.font.size, bp.font.color.rgb = PPTPt(18), PPTRGBColor.from_string(DARK_TEXT)
    prs.save(filepath)

def main():
    init_workspace()

    build_docx_document(
        BASE_DIR / "00_Executive_Summary" / "Executive_Summary.docx",
        "Executive Business Case", "Tier-1 Investment Committee Memorandum",
        venture_data["stage3_business_case"]["docx_blocks"],   # built from real stage output
    )
    build_docx_document(
        BASE_DIR / "05_Product" / "PRD_Product_Requirements.docx",
        "Product Requirements Document", "Version 1.0 Enterprise Baseline",
        venture_data["stage5_product"]["prd_blocks"],
    )
    # ... one build_docx_document() call per remaining stage doc (Stage 4, 6, 7, 9, 11, 12) ...

    build_financial_model(
        BASE_DIR / "08_Financial_Model" / "Financial_Model_Master.xlsx",
        venture_data["stage8_financials"],
    )
    build_investor_deck(
        BASE_DIR / "15_Final_Pack" / "Investor_Deck_Final.pptx",
        venture_data["final_summary"]["deck_slides"],
    )

    # write schema.sql, openapi.yaml, styles.css etc. from venture_data["stage13_technical_spec"]
    # zip BASE_DIR into a single archive for delivery

if __name__ == "__main__":
    main()
```

